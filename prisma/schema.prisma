// Sukhan Live Chat SaaS — canonical Prisma schema (PostgreSQL)
//
// PostgreSQL is the OFFICIAL database provider for Sukhan across all
// deployment modes:
//   - Vercel + Supabase PostgreSQL (cloud, serverless)
//   - Docker Full edition (self-hosted Postgres)
//   - Docker Lite edition (self-hosted Postgres — small container)
//   - Local development (Postgres via Docker or local install)
//
// SQLite is NO LONGER SUPPORTED. Standardizing on PostgreSQL lets us:
//   - ship a single canonical schema (no sync script, no schema drift)
//   - use real Prisma migrations (`prisma migrate deploy` in production)
//   - use Postgres-native types (JSONB, arrays) where helpful
//   - test migrations against the same database engine we run in prod
//
// Connection architecture (serverless-aware):
//   - `url` (DATABASE_URL)           — Supavisor pooled connection string
//                                       (port 6543 on Supabase). Used by
//                                       the Prisma Client at runtime.
//   - `directUrl` (DIRECT_URL)       — direct (non-pooled) connection string
//                                       (port 5432 on Supabase). Used by
//                                       `prisma migrate deploy` and
//                                       `prisma migrate status`. Required
//                                       because Supavisor's transaction-mode
//                                       pooling is incompatible with the
//                                       DDL statements Prisma Migrate emits.
//
// Both env vars are REQUIRED in production. In local dev (where you point
// DATABASE_URL at a local Postgres), you can set DIRECT_URL to the same
// value (no pooling layer to bypass).
//
// Tenant isolation is enforced in the application layer via a Prisma client
// extension (see src/lib/db.ts) PLUS explicit tenantId on every write.
// PostgreSQL Row-Level Security is treated as defense-in-depth ONLY and is
// NOT relied upon as the sole boundary (Prisma's privileged server-side
// connection may bypass policies depending on the configured database role).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A workspace/tenant. Root isolation boundary.
model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  defaultLocale   String   @default("fa")
  defaultDirection String  @default("rtl")
  plan            String   @default("free")
  workspaceCreatedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  departments     Department[]
  widgetConfig    WidgetConfig?
  contacts        Contact[]
  conversations   Conversation[]
  routingRules    RoutingRule[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  faqPairs        FaqPair[]
  products        Product[]
  aiConfig        AiConfig?
  connectorConfigs ConnectorConfig[]
  widgetDomains   WidgetDomain[]
}

/// Global identity. A user may belong to multiple tenants via Membership.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  avatarUrl    String?
  hasUsedFreeTrial Boolean @default(false)
  emailVerified    Boolean    @default(false)
  emailVerifiedAt  DateTime?
  passwordResetAt  DateTime?
  locale       String   @default("fa")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  Membership[]
  assignedConversations Conversation[] @relation("AssignedAgent")
  sentMessages  Message[]
  otpRequests  OtpRequest[]
  participants  Participant[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("agent")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   DepartmentMember[]
  conversations Conversation[]

  @@index([tenantId])
}

model DepartmentMember {
  departmentId String
  userId       String

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([departmentId, userId])
}

model WidgetConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  accentColor     String   @default("#E09A2B")
  launcherShape   String   @default("tab")
  position        String   @default("bottom-start")
  avatarUrl       String?
  logoUrl         String?
  greetingTexts   Json
  defaultLocale   String   @default("fa")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Contact {
  id          String   @id @default(cuid())
  tenantId    String
  identifier  String
  identifierType String @default("visitorId")
  name        String?
  email       String?
  avatarUrl   String?
  locale      String   @default("fa")
  metadata    Json
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, identifier])
  @@index([tenantId])
}

model Conversation {
  id             String   @id @default(cuid())
  tenantId       String
  contactId      String
  assignedUserId String?
  departmentId   String?
  status         String   @default("open")
  priority       String   @default("normal")
  channel        String   @default("widget")
  tags           Json
  lastMessageAt  DateTime @default(now())
  lastMessagePreview String @default("")
  unreadCount    Int      @default(0)
  csatRating     Int?
  csatComment    String?
  csatAt         DateTime?
  firstResponseAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser   User?    @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages       Message[]
  participants   Participant[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, departmentId])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  tenantId        String
  senderType      String   @default("contact")
  senderUserId    String?
  contentType     String   @default("text")
  content         Json
  status          String   @default("sent")
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser      User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

model Participant {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String
  tenantId        String
  lastReadAt      DateTime @default(now())
  muted           Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId])
}

model RoutingRule {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  enabled     Boolean  @default(true)
  priority    Int      @default(0)
  trigger     Json
  action      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
}

model Plan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  priceToman  Int      @default(0)
  interval    String   @default("month")
  limits      Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
}

model Subscription {
  id          String   @id @default(cuid())
  tenantId    String
  planId      String
  status      String   @default("pending")
  gateway     String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices    Invoice[]

  @@index([tenantId, status])
}

model Invoice {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String
  planId          String
  amountToman     Int
  gateway         String
  authority       String?
  refId           String?
  status          String   @default("pending")
  callbackUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan            Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([subscriptionId])
}

model AiConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  faqEnabled      Boolean  @default(false)
  productQaEnabled Boolean @default(false)
  aiActionCount   Int      @default(0)
  aiActionResetAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FaqPair {
  id          String   @id @default(cuid())
  tenantId    String
  question    String
  answer      String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String   @default("")
  price       Int      @default(0)
  currency    String   @default("IRT")
  availability String  @default("in_stock")
  sku         String?
  externalId  String?
  externalSource String?
  metadata    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, externalSource])
}

model ConnectorConfig {
  id         String    @id @default(cuid())
  tenantId   String
  type       String
  config     Json
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

model WidgetDomain {
  id        String   @id @default(cuid())
  tenantId  String
  domain    String
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, domain])
  @@index([tenantId])
}

model SelfHostRequest {
  id        String   @id @default(cuid())
  name      String
  company   String
  email     String
  phone     String
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model OtpRequest {
  id          String   @id @default(cuid())
  userId      String?
  email       String
  purpose     String
  requestId   String   @unique
  expiresAt   DateTime
  attempts    Int      @default(0)
  resendCount Int      @default(0)
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([email, purpose])
  @@index([requestId])
}

model PendingSignup {
  id            String   @id @default(cuid())
  email         String   @unique
  nixifyRequestId String?
  otpVerified   Boolean  @default(false)
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([email])
}
