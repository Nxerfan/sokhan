// Live Chat SaaS — Module 1+2 schema (default SQLITE variant for dev/Docker Lite)
//
// The postgresql-flavoured mirror lives at `prisma/schema.postgres.prisma`
// and is used on Vercel and Docker Full. Keep them in sync via:
//
//   bun run sync-prisma-schemas
//
// Tenant isolation is enforced in the application layer via a Prisma client
// extension (see src/lib/db.ts) PLUS explicit tenantId on every write (Module 2
// convention — the extension is unreliable for create in Turbopack dev mode).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A workspace/tenant. Root isolation boundary.
model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  defaultLocale   String   @default("fa")
  defaultDirection String  @default("rtl")
  plan            String   @default("free")
  workspaceCreatedAt DateTime @default(now()) // tracks 30-day free trial
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  departments     Department[]
  widgetConfig    WidgetConfig?
  contacts        Contact[]
  conversations   Conversation[]
  routingRules    RoutingRule[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  faqPairs        FaqPair[]
  products        Product[]
  aiConfig        AiConfig?
  connectorConfigs ConnectorConfig[]
  widgetDomains   WidgetDomain[]
}

/// Global identity. A user may belong to multiple tenants via Membership.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  avatarUrl    String?
  hasUsedFreeTrial Boolean @default(false) // prevents re-creating free workspaces
  emailVerified    Boolean    @default(false)
  emailVerifiedAt  DateTime?
  passwordResetAt  DateTime?
  locale       String   @default("fa")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  Membership[]
  assignedConversations Conversation[] @relation("AssignedAgent")
  sentMessages  Message[]
  otpRequests  OtpRequest[]
  participants  Participant[]
}

/// Authorization pivot: binds a User to a Tenant with a role.
/// Roles: owner | admin | manager | agent | viewer
model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("agent")
  status    String   @default("active") // active | invited | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Lightweight team grouping used for routing (Module 2).
model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   DepartmentMember[]
  conversations Conversation[]

  @@index([tenantId])
}

model DepartmentMember {
  departmentId String
  userId       String

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([departmentId, userId])
}

/// Customer-facing chat widget appearance. Per ADR-7 redline: the product's
/// own ink/saffron/turquoise palette is NOT imposed on customer widgets; each
/// tenant configures its own accent, launcher, position, avatar and greeting.
model WidgetConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  accentColor     String   @default("#E09A2B")
  launcherShape   String   @default("tab") // tab | rounded | pill
  position        String   @default("bottom-start") // bottom-start | bottom-end
  avatarUrl       String?
  logoUrl         String?
  greetingTexts   Json     // { "fa": "...", "en": "..." } — set in app code on create
  defaultLocale   String   @default("fa")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ============================================================
// Module 2 — Realtime messaging entities
// ============================================================

/// A visitor/customer identified by (tenantId, identifier). Deduped by email
/// if provided, otherwise by a generated visitorId stored in widget localStorage.
model Contact {
  id          String   @id @default(cuid())
  tenantId    String
  identifier  String   // email or visitorId
  identifierType String @default("visitorId") // email | visitorId
  name        String?
  email       String?
  avatarUrl   String?
  locale      String   @default("fa")
  metadata    Json     // set in app code on create
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, identifier])
  @@index([tenantId])
}

/// A conversation between a contact and agents. Channel-agnostic.
model Conversation {
  id             String   @id @default(cuid())
  tenantId       String
  contactId      String
  assignedUserId String?
  departmentId   String?
  status         String   @default("open") // open | pending | closed
  priority       String   @default("normal") // low | normal | high
  channel        String   @default("widget") // widget | whatsapp | telegram | instagram
  tags           Json     // set in app code on create — []
  lastMessageAt  DateTime @default(now())
  lastMessagePreview String @default("")
  unreadCount    Int      @default(0)
  csatRating     Int?     // 1-5, null = not yet rated
  csatComment    String?
  csatAt         DateTime?
  firstResponseAt DateTime? // when the first agent reply was sent
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser   User?    @relation("AssignedAgent", fields: [assignedUserId], references: [id], onDelete: SetNull)
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  messages       Message[]
  participants   Participant[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, departmentId])
}

/// A message in a conversation. senderType distinguishes agent/contact/ai/system.
model Message {
  id              String   @id @default(cuid())
  conversationId  String
  tenantId        String
  senderType      String   @default("contact") // agent | contact | ai | system
  senderUserId    String?
  contentType     String   @default("text") // text | image | file | system
  content         Json     // { text?: string, attachments?: [{url, type, name}] }
  status          String   @default("sent") // sent | delivered | read
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser      User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

/// Tracks which agents are participating in a conversation + their read state.
model Participant {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String
  tenantId        String
  lastReadAt      DateTime @default(now())
  muted           Boolean  @default(false)
  createdAt       DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([tenantId])
}

/// Rule-based automation: trigger (event + conditions) → action.
model RoutingRule {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  enabled     Boolean  @default(true)
  priority    Int      @default(0)
  trigger     Json     // { event: "conversation_created", conditions: {...} }
  action      Json     // { type: "assign_department"|"assign_user"|"add_tag"|"send_message", ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
}

// ============================================================
// Module 3 — Billing & payments (Iran-first gateways)
// ============================================================

/// Catalog of subscription plans. The slug is the canonical identifier used
/// throughout the app (e.g. `free`, `pro`, `business`, `enterprise`). Limits
/// are stored as JSON so we can evolve the schema without migrations.
model Plan {
  id          String   @id @default(cuid())
  slug        String   @unique // free | pro | business | enterprise
  name        String
  priceToman  Int      @default(0) // 0 for free / contact-sales tiers
  interval    String   @default("month") // month | year | once
  limits      Json     // { agents, conversations, departments } — -1 = unlimited
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
}

/// A tenant's subscription to a plan. A tenant has at most one active
/// subscription at a time (status: active). New subscriptions start as
/// `pending` until the payment callback verifies the payment.
model Subscription {
  id          String   @id @default(cuid())
  tenantId    String
  planId      String
  status      String   @default("pending") // pending | active | canceled | expired
  gateway     String?  // zarinpal | idpay | zarinlink
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices    Invoice[]

  @@index([tenantId, status])
}

/// An invoice for a subscription payment. Tracks the lifecycle of a single
/// payment attempt: pending → paid (or failed). The `authority` is the
/// gateway-specific token returned by `createPayment` and used to verify on
/// callback.
model Invoice {
  id              String   @id @default(cuid())
  tenantId        String
  subscriptionId  String
  planId          String
  amountToman     Int
  gateway         String   // zarinpal | idpay | zarinlink
  authority       String?  // gateway token (Authority / track_id / token)
  refId           String?  // gateway reference id returned on verify
  status          String   @default("pending") // pending | paid | failed
  callbackUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime?

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan            Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([subscriptionId])
}

// ============================================================
// Module 4 — AI features (FAQ auto-responder + Product Q&A)
// ============================================================

/// Tenant-level AI configuration. One row per tenant (created on first use).
/// Both features default to OFF — tenants must explicitly opt in.
model AiConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  faqEnabled      Boolean  @default(false)
  productQaEnabled Boolean @default(false)
  /// Monthly AI action counter (reset by the gating module on calendar month).
  /// Actual counting is done via Message.senderType='ai' — this is a cached value.
  aiActionCount   Int      @default(0)
  aiActionResetAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// FAQ question/answer pairs for the smart auto-responder.
model FaqPair {
  id          String   @id @default(cuid())
  tenantId    String
  question    String
  answer      String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
}

/// Internal product catalog — unified source of truth for AI product Q&A.
/// Products can be added manually or synced from external stores (WooCommerce, etc.).
model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String   @default("")
  price       Int      @default(0) // in Toman
  currency    String   @default("IRT")
  availability String  @default("in_stock") // in_stock | out_of_stock | limited
  sku         String?
  externalId  String?  // ID from external store (e.g., WooCommerce product ID)
  externalSource String? // woocommerce | manual | csv
  metadata    Json     // set in app code on create // additional fields from external source
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, externalSource])
}

// ============================================================
// Module 4 — External store connectors
// ============================================================

/// Per-tenant connector configuration for an external store integration
/// (WooCommerce, Shopify, Basalam, etc.). The `config` JSON holds the
/// source-specific credentials (e.g. WooCommerce consumerKey/consumerSecret,
/// Shopify access token). One row per (tenantId, type) — re-saving overwrites
/// the previous config so credentials can be rotated.
model ConnectorConfig {
  id         String    @id @default(cuid())
  tenantId   String
  type       String   // woocommerce | shopify | basalam | ...
  config     Json     // source-specific credentials, e.g. { storeUrl, consumerKey, consumerSecret }
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
  @@index([tenantId])
}

// ============================================================
// Module 6 — Plan restructure + widget domains + self-host requests
// ============================================================

/// Allowed website domains for widget embedding. Each "API key" = one domain.
/// Free plan: 1 domain, Pro: 3, Max: 8.
model WidgetDomain {
  id        String   @id @default(cuid())
  tenantId  String
  domain    String   // e.g., "example.com" (normalized: lowercase, no protocol/port)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, domain])
  @@index([tenantId])
}

/// Self-hosted deployment request form submissions. Global (not tenant-scoped).
model SelfHostRequest {
  id        String   @id @default(cuid())
  name      String
  company   String
  email     String
  phone     String
  message   String?
  status    String   @default("pending") // pending | contacted | resolved
  createdAt DateTime @default(now())
}

// ============================================================
// Module 7 — OTP-based authentication
// ============================================================

/// OTP verification request. Global (not tenant-scoped) — tied to user accounts.
model OtpRequest {
  id          String   @id @default(cuid())
  userId      String?
  email       String
  purpose     String   // 'signup' | 'login' | 'reset_password'
  requestId   String   @unique  // Nixify request_id
  expiresAt   DateTime
  attempts    Int      @default(0)
  resendCount Int      @default(0)
  verified    Boolean  @default(false)
  verifiedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([email, purpose])
  @@index([requestId])
}

/// Holds partially-completed signups (between OTP verification and account creation).
model PendingSignup {
  id            String   @id @default(cuid())
  email         String   @unique
  nixifyRequestId String?
  otpVerified   Boolean  @default(false)
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([email])
}
