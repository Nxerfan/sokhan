# ============================================================
# Sukhan Caddy reverse proxy (Docker edition)
# ============================================================
# Routes traffic to the Next.js app and the realtime Socket.IO service.
# Uses the SAME XTransformPort query-param pattern as the sandbox
# Caddyfile so widget + dashboard clients don't need to know they're
# talking to Docker services — they just use relative URLs with
# ?XTransformPort=3003 for Socket.IO handshakes.
#
# SECURITY: only XTransformPort=3003 (the public Socket.IO port) is
# accepted. The internal realtime HTTP service on port 3004 (which
# exposes /health and /internal/publish) is NEVER publicly routable
# through this mechanism. Arbitrary port values are NOT proxied.
#
# Set DOMAIN env var to your domain (e.g. chat.example.com) for auto-HTTPS
# via Let's Encrypt. Leave empty for HTTP-only on port 80 (local/testing).
# ============================================================

{
    # Email for Let's Encrypt certificate expiry notifications.
    # Only used when DOMAIN is set.
    email {$ACME_EMAIL:admin@example.com}

    # Disable the admin API (not needed in production).
    admin off
}

# Site address: if DOMAIN is set, use it (enables auto-HTTPS on 80+443).
# Otherwise fall back to :80 (HTTP only, for local testing).
{$DOMAIN::80} {
    # Socket.IO traffic — identified by the EXACT query param
    # ?XTransformPort=3003. This is the ONLY public realtime port.
    # The matcher uses an exact value (not a wildcard) so that
    # ?XTransformPort=3004 (internal HTTP) or any other port value
    # is NOT proxied to the realtime container.
    @realtime_3003 {
        query XTransformPort=3003
    }
    handle @realtime_3003 {
        reverse_proxy realtime:3003 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # Everything else → Next.js app.
    # This includes: REST API, dashboard, widget script, config,
    # and any request without ?XTransformPort=3003.
    # Requests with ?XTransformPort=3004 or arbitrary values
    # fall through to this handler (→ Next.js app) which will
    # NOT serve realtime endpoints — they are simply ignored.
    handle {
        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }
}
