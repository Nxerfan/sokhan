# ============================================================
# Sukhan Live Chat SaaS — Vercel Environment Configuration
# ============================================================
#
# This is a TEMPLATE — copy each value into the Vercel dashboard
# (Project → Settings → Environment Variables) or set via `vercel env`.
# DO NOT commit a real .env file with production secrets.
#
# Architecture:
#   - Next.js app          → Vercel serverless functions
#   - PostgreSQL           → Neon (pooled runtime + direct migration)
#   - Realtime Socket.IO   → root api/realtime.ts Vercel Function
#   - Socket.IO path       → /api/realtime (websocket-only)
#   - Redis                 → REDIS_URL (for cross-function pub/sub)
#   - Storage              → Vercel Blob
#   - Authentication       → NextAuth
#
# Build:
#   Vercel uses installCommand: "bash vercel-install.sh" from vercel.json
#   which installs deps, runs prisma generate + migrate deploy, then
#   Vercel's default Next.js build runs automatically.
# ============================================================


# --- Authentication ---

# [REQUIRED] Secret key for signing NextAuth JWT sessions and realtime tokens.
# Both the Next.js app AND the api/realtime.ts function use this.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# [REQUIRED] The public URL of your Vercel deployment.
NEXTAUTH_URL=https://your-sukhan-app.vercel.app


# --- Database (Neon PostgreSQL) ---

# Neon provides two connection strings (Neon Console → Connection Details):
#
#   1. Pooled connection (pooler hostname) — for the Prisma Client at runtime.
#   2. Direct connection (no pooler) — for Prisma Migrate (DDL).
#
# The Neon Vercel integration auto-syncs these as env vars:
#   DATABASE_URL         → pooled (pooler hostname)
#   DATABASE_URL_UNPOOLED → direct (no pooler)

# [REQUIRED] Runtime pooled connection (Neon pooler).
DATABASE_URL=<neon-pooled-postgres-url>

# [REQUIRED for migrations] Direct/non-pooled connection.
# Either set DIRECT_URL explicitly OR rely on DATABASE_URL_UNPOOLED
# (auto-synced by the Neon Vercel integration).
# vercel-install.sh falls back to DATABASE_URL_UNPOOLED if DIRECT_URL is not set.
# If neither is set, the build fails with a clear error.
DIRECT_URL=<neon-direct-postgres-url>
# DATABASE_URL_UNPOOLED is auto-provided by Neon integration.


# --- Realtime (Redis for cross-function pub/sub) ---

# [REQUIRED for real-time delivery] Redis URL for publishing Socket.IO
# events from Next.js serverless functions to the api/realtime.ts
# Vercel Function's Socket.IO subscriber.
#
# Use Upstash Redis (via Vercel Marketplace) or any Redis-compatible service.
# The `redis` Node package + @socket.io/redis-adapter are used (not REST APIs).
REDIS_URL=<redis-url>

# [OPTIONAL] Channel name for realtime pub/sub. Defaults to
# "sukhan:realtime:publish".
# REDIS_CHANNEL=sukhan:realtime:publish


# --- Realtime (Socket.IO) ---

# [OPTIONAL] By default, Socket.IO runs inside the Vercel Function at
# api/realtime.ts with path /api/realtime. No external realtime host is needed.
#
# For advanced use cases (e.g., custom WebSocket gateway), set this to
# override the built-in Vercel realtime. NOT needed for normal deployment.
# NEXT_PUBLIC_REALTIME_URL=https://realtime.your-domain.com


# --- Object Storage (Vercel Blob) ---

# [REQUIRED for attachment uploads] Vercel Blob read-write token.
BLOB_READ_WRITE_TOKEN=<vercel-blob-token>


# --- OTP / Email Verification (Nixify) ---

NIXIFY_API_KEY=<nixify-api-key>
# Production uses https://nixify.ir automatically. NIXIFY_BASE_URL is NOT needed.

# [OPTIONAL] Set to "true" to mock the Nixify API in development.
# NIXIFY_MOCK=true


# --- Billing (Iran-first gateways: ZarinPal / IDPay / ZarinLink) ---

# [OPTIONAL] Each gateway is independently configurable.
# ZARINPAL_MERCHANT_ID=<zarinpal-merchant-id>
# ZARINPAL_SANDBOX=true
# IDPAY_API_KEY=<idpay-api-key>
# ZARINLINK_URL=https://zarin.link/your-link
