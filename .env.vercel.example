# ============================================================
# Sukhan Live Chat SaaS — Vercel Environment Configuration
# ============================================================
#
# This is a TEMPLATE — copy each value into the Vercel dashboard
# (Project → Settings → Environment Variables) or set via `vercel env`.
# DO NOT commit a real .env file with production secrets.
#
# Official cloud database: Supabase PostgreSQL (via Supavisor pooling).
#
# On Vercel, the build runs `bash vercel-build.sh` (configured in
# vercel.json) which:
#   1. Generates the Prisma client against the canonical PostgreSQL schema.
#   2. Runs `prisma migrate deploy` against DIRECT_URL (NOT `db push`).
#   3. Runs `next build` WITHOUT `output: 'standalone'`.
#
# All [REQUIRED] variables MUST be set or Vercel deployment will fail
# at runtime (the app will throw a clear configuration error).
# All [OPTIONAL] variables have sensible defaults or are mode-specific.
# ============================================================


# --- Authentication ---

# [REQUIRED] Secret key for signing NextAuth JWT sessions and realtime tokens.
# Both the Next.js app AND the separately-hosted realtime service MUST use
# the SAME value. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# [REQUIRED] The public URL of your Vercel deployment.
# Set this to your canonical Vercel domain (configured in Vercel → Project → Domains).
NEXTAUTH_URL=https://your-sukhan-app.vercel.app


# --- Database (Supabase PostgreSQL via Supavisor) ---
#
# Supabase provides TWO connection strings (Dashboard → Project → Database →
# Connection string):
#
#   1. Pooled connection (Supavisor, port 6543) — for the Prisma Client at
#      runtime. Append `?pgbouncer=true&connection_limit=1` (Supavisor is
#      PgBouncer-compatible at the protocol level; `connection_limit=1` is
#      the recommended setting for serverless Prisma).
#
#   2. Direct connection (port 5432) — for Prisma Migrate. DDL (CREATE TABLE,
#      ALTER TABLE, etc.) is INCOMPATIBLE with transaction-mode pooling, so
#      `prisma migrate deploy` requires the direct connection.
#
# Format:
#   DATABASE_URL = postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# Replace [project-ref], [region], and [password] with your actual Supabase
# values. NEVER commit real credentials.

# [REQUIRED] Runtime pooled connection (Supavisor, port 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# [REQUIRED] Migration / direct connection (port 5432, no pooling).
# Used by `prisma migrate deploy` and `prisma migrate status`.
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres


# --- Realtime (Redis pub/sub via Upstash) ---

# [REQUIRED for real-time delivery] Redis URL for publishing Socket.IO
# events from the Next.js serverless functions to the realtime service.
# Get this from Upstash Redis (or any Redis-compatible host).
#
# If you leave this unset, the app falls back to the 10-second polling
# safety net (messages still persist to DB, just not real-time).
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@us1-YOUR_UPSTASH_HOST.upstash.io:6379

# [OPTIONAL] Channel name for realtime pub/sub. Defaults to
# "sukhan:realtime:publish" — change only if you run multiple Sukhan
# environments on a shared Redis cluster.
# REDIS_CHANNEL=sukhan:realtime:publish


# --- Realtime Service (separately-hosted, long-lived Socket.IO host) ---

# [REQUIRED for real-time delivery] The PUBLIC URL of your separately-hosted
# realtime Socket.IO service. The dashboard and widget clients connect to
# this URL directly (NOT through Vercel — Vercel can't host a long-lived
# Socket.IO server).
#
# Host the realtime service on Railway / Render / Fly.io / a small VPS.
# See mini-services/realtime/index.ts for the runtime.
#
# Vercel-hosted clients connect to this URL with path: '/'.
NEXT_PUBLIC_REALTIME_URL=https://realtime.your-domain.com

# [OPTIONAL] If your realtime service exposes the internal HTTP publish
# endpoint (port 3004 in Docker), set this to its private URL. The Next.js
# serverless functions will POST to it instead of using Redis (which can
# be simpler for a single-instance realtime service).
# REALTIME_INTERNAL_URL=https://realtime.your-domain.com


# --- Object Storage (Vercel Blob) ---

# [REQUIRED for attachment uploads] Vercel Blob read-write token.
# Create a Blob store in Vercel → Storage → Create → Blob. Copy the
# read-write token.
# The `@vercel/blob` package is already a dependency — no install needed.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_TOKEN_HERE


# --- OTP / Email Verification (Nixify) ---

# [REQUIRED for signup + login OTP] Nixify API key + base URL.
NIXIFY_API_KEY=mg_live_YOUR_NIXIFY_API_KEY
NIXIFY_BASE_URL=https://your-nixify-domain.com/api/v1

# [OPTIONAL] Set to "true" to mock the Nixify API in development (the OTP
# is always 123456, no real email is sent). Leave unset in production.
# NIXIFY_MOCK=true


# --- Billing (Iran-first gateways: ZarinPal / IDPay / ZarinLink) ---

# [OPTIONAL] Each gateway is independently configurable. If unset, the
# gateway runs in test mode (simulated success).
# ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ZARINPAL_SANDBOX=true
# IDPAY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ZARINLINK_URL=https://zarin.link/your-link
