{
  "name": "sukhan-widget",
  "version": "1.0.0",
  "description": "Bilingual (Persian / English) live-chat widget for the Sukhan platform. Auto-initializes in any browser environment, no-op on the server (SSR-safe).",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "sukhan",
    "live-chat",
    "widget",
    "chat",
    "persian",
    "rtl",
    "bilingual",
    "socket.io"
  ],
  "dependencies": {},
  "peerDependencies": {},
  "engines": {
    "node": ">=18"
  }
}
