{
  "name": "sukhan-widget",
  "version": "1.0.0",
  "description": "Bilingual (Persian / English) live-chat widget for the Sukhan platform. Auto-initializes in any browser environment, no-op on the server (SSR-safe).",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "sukhan",
    "live-chat",
    "widget",
    "chat",
    "persian",
    "rtl",
    "bilingual",
    "socket.io"
  ],
  "dependencies": {},
  "peerDependencies": {},
  "engines": {
    "node": ">=18"
  }
}
